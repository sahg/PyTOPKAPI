# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artefacts (regenerated by pip/setuptools)
build/
dist/
.eggs/
*.egg
*.egg-info/

# ─── Environments ────────────────────────────────────────────────
.venv/
venv/
env/
.conda/
.python-version

# ─── Testing & coverage ──────────────────────────────────────────
.pytest_cache/
.nose*
.tox/
.coverage
.coverage.*
htmlcov/

# ─── Jupyter ─────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Docs ────────────────────────────────────────────────────────
docs/build/

# ─── Editors / OS ────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
*~

# ─── Project data (restricted — see §6 of the project brief) ─────
# Several SA layers (Land Type, DWS flow, WWTW records) are licence-
# restricted and must NOT be committed. Keep raw data out of the repo;
# commit only configs and manifests. Adjust these paths to taste.
projects/*/data/
projects/*/terrain/
projects/*/soil/
projects/*/results/
projects/*/forcing/
projects/*/figs/
projects/*/raw/
projects/*/soil/
projects/*/run/
projects/*/*.dat
projects/*/*.ini
example_simulation/.DS_Store
# NOTE: example_simulation/results/ is deliberately NOT ignored — it is
# the committed regression fixture for the Liebenbergsvlei example.